            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 9002,\n  \"courseId\": 9001,\n  \"title\": \"API joins\",\n  \"content\": \"Inner and outer joins\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
