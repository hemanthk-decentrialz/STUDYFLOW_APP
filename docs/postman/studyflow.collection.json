        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/timers/current"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.environment.set(\"timer_revision\", pm.response.json().data.revision);"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Start timer",
      "request": {
