          }
        }
      ]
    },
    {
      "name": "06 Search and paginate notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/notes?search=joins&course_id=9001&sort_by=title&order=asc&page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Edit note with optimistic version",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/notes/9002",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": 1,\n  \"content\": \"Updated study notes\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Stale edit is rejected",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/notes/9002",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": 1,\n  \"content\": \"Stale edit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Duplicate title is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 9003,\n  \"courseId\": 9001,\n  \"title\": \"API joins\",\n  \"content\": \"Duplicate\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
