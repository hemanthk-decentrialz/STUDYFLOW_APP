APP_ENV=development
# REQUIRED: fill with your own URL; no database credentials are shipped.
DATABASE_URL=postgresql+asyncpg://studyflow_app:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/studyflow
# Optional in development; required in production.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_ORIGIN=http://localhost:8000
TRUSTED_HOSTS=["localhost","127.0.0.1"]
COOKIE_SECURE=false
SESSION_COOKIE_NAME=studyflow_session
DOCS_ENABLED=true
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_AUTH=6/minute
RATE_LIMIT_SIGNUP=10/hour
RATE_LIMIT_RESETS=5/hour
MAX_REQUEST_BYTES=524288
